            "name": "chart_condition_breakdown",
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": { "fieldName": "model_name", "displayName": "Candidate Model" },
                "y": { "fieldName": "mean_brier", "displayName": "Brier Loss", "aggregation": "AVG" },
                "color": { "fieldName": "evaluation_provenance", "displayName": "Evaluation Provenance" }
              },
              "frame": {
                "title": "Model Performance Across Provenance Tiers"
              }
            },
            "datasetName": "ds_model_leaderboard"
          },
          "position": { "x": 0, "y": 10, "width": 12, "height": 5 }
        }
      ]
    },
