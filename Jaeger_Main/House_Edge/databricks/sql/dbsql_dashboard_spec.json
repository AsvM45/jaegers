{
  "version": 1,
  "displayName": "JAEGERS House Edge: Lakehouse Experiment & Calibration Dashboard",
  "description": "Production AI/BI Lakeview dashboard for JAEGERS House Edge model evaluation, calibration curves, regime drift, and Medallion lineage.",
  "datasets": [
    {
      "name": "ds_model_leaderboard",
      "displayName": "Model Leaderboard & Provenance",
      "queryLines": [
        "SELECT \n",
        "  run_id,\n",
        "  model_name,\n",
        "  model_type,\n",
        "  evaluation_provenance,\n",
        "  champion_status,\n",
        "  ROUND(mean_brier, 6) AS mean_brier,\n",
        "  ROUND(log_loss, 6) AS log_loss,\n",
        "  ROUND(ece_calibration, 6) AS ece_calibration,\n",
        "  ROUND(brier_stable, 6) AS brier_stable,\n",
        "  ROUND(brier_short_history, 6) AS brier_short_history,\n",
        "  ROUND(brier_drift, 6) AS brier_drift,\n",
        "  ROUND(brier_shared_change, 6) AS brier_shared_change,\n",
        "  git_commit,\n",
        "  created_at,\n",
        "  ROW_NUMBER() OVER (PARTITION BY evaluation_provenance ORDER BY mean_brier ASC) AS rank_in_provenance\n",
        "FROM gold_model_evaluations\n",
        "ORDER BY evaluation_provenance ASC, mean_brier ASC\n"
      ],
      "columns": [
        {
          "displayName": "Mean Brier Loss",
          "expression": "MIN(mean_brier)"
        },
        {
          "displayName": "Best Log Loss",
          "expression": "MIN(log_loss)"
        },
        {
          "displayName": "Total Models",
          "expression": "COUNT(DISTINCT model_name)"
        }
      ]
    },
    {
      "name": "ds_payout_calibration",
      "displayName": "Payout Calibration Curves",
      "queryLines": [
        "WITH unpivoted AS (\n",
        "  SELECT p.query_id, p.model_name, 0 AS payout_class, p.p_0 AS pred_prob, CASE WHEN q.outcome = 0 THEN 1.0 ELSE 0.0 END AS actual FROM gold_predictions p JOIN silver_queries q ON p.query_id = q.query_id\n",
        "  UNION ALL SELECT p.query_id, p.model_name, 1 AS payout_class, p.p_1 AS pred_prob, CASE WHEN q.outcome = 1 THEN 1.0 ELSE 0.0 END AS actual FROM gold_predictions p JOIN silver_queries q ON p.query_id = q.query_id\n",
        "  UNION ALL SELECT p.query_id, p.model_name, 2 AS payout_class, p.p_2 AS pred_prob, CASE WHEN q.outcome = 2 THEN 1.0 ELSE 0.0 END AS actual FROM gold_predictions p JOIN silver_queries q ON p.query_id = q.query_id\n",
        "  UNION ALL SELECT p.query_id, p.model_name, 5 AS payout_class, p.p_5 AS pred_prob, CASE WHEN q.outcome = 5 THEN 1.0 ELSE 0.0 END AS actual FROM gold_predictions p JOIN silver_queries q ON p.query_id = q.query_id\n",
        "  UNION ALL SELECT p.query_id, p.model_name, 20 AS payout_class, p.p_20 AS pred_prob, CASE WHEN q.outcome = 20 THEN 1.0 ELSE 0.0 END AS actual FROM gold_predictions p JOIN silver_queries q ON p.query_id = q.query_id\n",
        "),\n",
        "binned AS (\n",
        "  SELECT query_id, model_name, payout_class, pred_prob, actual, NTILE(10) OVER (PARTITION BY model_name, payout_class ORDER BY pred_prob ASC) AS prob_decile FROM unpivoted\n",
        ")\n",
        "SELECT \n",
        "  model_name,\n",
        "  CONCAT(CAST(payout_class AS STRING), 'x Payout') AS payout_label,\n",
        "  payout_class,\n",
        "  prob_decile,\n",
        "  COUNT(*) AS bin_count,\n",
        "  ROUND(AVG(pred_prob), 5) AS avg_predicted_prob,\n",
        "  ROUND(AVG(actual), 5) AS observed_win_rate,\n",
        "  ROUND(ABS(AVG(pred_prob) - AVG(actual)), 5) AS bin_calibration_error\n",
        "FROM binned\n",
        "GROUP BY model_name, payout_label, payout_class, prob_decile\n",
        "ORDER BY model_name, payout_class, prob_decile\n"
      ]
    },
    {
      "name": "ds_regime_drift",
      "displayName": "Machine Regime & Split Drift",
      "queryLines": [
        "SELECT \n",
        "  q.split,\n",
        "  q.machine_type,\n",
        "  COUNT(*) AS query_count,\n",
        "  ROUND(AVG(q.cutoff * 1.0), 1) AS avg_cutoff,\n",
        "  ROUND(AVG(COALESCE(e.total_spins_observed, 0) * 1.0), 1) AS avg_spins,\n",
        "  ROUND(AVG(COALESCE(e.win_rate, 0.0)), 4) AS avg_win_rate,\n",
        "  ROUND(AVG((q.cutoff - COALESCE(e.total_spins_observed, 0)) * 100.0 / NULLIF(q.cutoff, 0)), 2) AS missing_ticks_pct\n",
        "FROM silver_queries q\n",
        "LEFT JOIN silver_episodes e ON q.episode_id = e.episode_id AND q.split = e.split\n",
        "GROUP BY q.split, q.machine_type\n",
        "ORDER BY q.split, q.machine_type\n"
      ]
    },
    {
      "name": "ds_lineage_and_audit",
      "displayName": "Bronze Ingestion Audit & Lineage",
      "queryLines": [
        "SELECT \n",
        "  dataset_name,\n",
        "  split,\n",
        "  status,\n",
        "  record_count,\n",
        "  ROUND(file_size_bytes / 1024.0, 2) AS file_size_kb,\n",
        "  SUBSTRING(sha256_checksum, 1, 16) AS sha256_prefix,\n",
        "  sha256_checksum,\n",
        "  file_path,\n",
        "  ingested_at\n",
        "FROM bronze_audit_log\n",
        "ORDER BY split ASC, dataset_name ASC\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_executive_leaderboard",
      "displayName": "Executive Model Leaderboard",
      "layout": [
        {
          "widget": {
            "name": "title_executive",
            "multilineTextboxSpec": {
              "lines": [
                "# JAEGERS House Edge: Production Model Governance & Leaderboard\n",
                "\n",
                "Continuous tracking of ML candidate models evaluated across **Public Validation** and **Grouped CV** splits. Tracks multi-class Brier loss, log loss, calibration error (ECE), and condition robustness."
              ]
            }
          },
          "position": { "x": 0, "y": 0, "width": 12, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_champion_brier",
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "mean_brier",
                  "displayName": "Champion Mean Brier",
                  "aggregation": "MIN"
                }
              },
              "frame": {
                "title": "Champion Mean Brier",
                "description": "Lowest observed multi-class Brier score"
              }
            },
            "datasetName": "ds_model_leaderboard"
          },
          "position": { "x": 0, "y": 2, "width": 3, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_champion_log_loss",
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "log_loss",
                  "displayName": "Champion Log Loss",
                  "aggregation": "MIN"
                }
              },
              "frame": {
                "title": "Champion Log Loss",
                "description": "Best multi-class cross-entropy loss"
              }
            },
            "datasetName": "ds_model_leaderboard"
          },
          "position": { "x": 3, "y": 2, "width": 3, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_best_ece",
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "ece_calibration",
                  "displayName": "Best ECE",
                  "aggregation": "MIN"
                }
              },
              "frame": {
                "title": "Best Calibration ECE",
                "description": "Expected Calibration Error across deciles"
              }
            },
            "datasetName": "ds_model_leaderboard"
          },
          "position": { "x": 6, "y": 2, "width": 3, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_total_models",
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "model_name",
                  "displayName": "Registered Models",
                  "aggregation": "COUNT_DISTINCT"
                }
              },
              "frame": {
                "title": "Total Models Tracked",
                "description": "Registered trial candidates in MLflow & Delta"
              }
            },
            "datasetName": "ds_model_leaderboard"
          },
          "position": { "x": 9, "y": 2, "width": 3, "height": 2 }
        },
        {
          "widget": {
            "name": "table_leaderboard",
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "rank_in_provenance", "displayName": "Rank" },
                  { "fieldName": "model_name", "displayName": "Model" },
                  { "fieldName": "model_type", "displayName": "Architecture" },
                  { "fieldName": "champion_status", "displayName": "Status" },
                  { "fieldName": "evaluation_provenance", "displayName": "Provenance" },
                  { "fieldName": "mean_brier", "displayName": "Mean Brier" },
                  { "fieldName": "log_loss", "displayName": "Log Loss" },
                  { "fieldName": "ece_calibration", "displayName": "ECE" },
                  { "fieldName": "brier_stable", "displayName": "Brier (Stable)" },
                  { "fieldName": "brier_short_history", "displayName": "Brier (Short Hist)" },
                  { "fieldName": "brier_drift", "displayName": "Brier (Drift)" },
                  { "fieldName": "brier_shared_change", "displayName": "Brier (Shared Chg)" },
                  { "fieldName": "git_commit", "displayName": "Git Commit" }
                ]
              },
              "frame": {
                "title": "Full Model Leaderboard with Evaluation Provenance"
              }
            },
            "datasetName": "ds_model_leaderboard"
          },
          "position": { "x": 0, "y": 4, "width": 12, "height": 6 }
        },
        {
