                  { "fieldName": "episodes", "displayName": "Episodes" }
                ]
              },
              "frame": {
                "title": "Paired Bootstrap 95% CI Comparison Ledger"
              }
            },
            "datasetName": "ds_paired_ci95_gate"
          },
