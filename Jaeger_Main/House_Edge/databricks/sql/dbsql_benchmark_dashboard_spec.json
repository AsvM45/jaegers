                "y": { "fieldName": "mean_delta", "displayName": "Mean Paired Delta", "aggregation": "AVG" },
                "color": { "fieldName": "promotion_decision", "displayName": "Gate Decision" }
              },
              "frame": {
                "title": "Paired Bootstrap Mean Delta by Candidate and Gate Decision"
              }
