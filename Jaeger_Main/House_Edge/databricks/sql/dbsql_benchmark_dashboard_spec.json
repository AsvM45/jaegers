          "position": { "x": 8, "y": 2, "width": 4, "height": 2 }
        },
        {
          "widget": {
            "name": "table_provenance_leaderboard",
            "spec": {
              "version": 2,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "evaluation_provenance", "displayName": "Provenance Tier" },
                  { "fieldName": "rank_within_provenance", "displayName": "Tier Rank" },
                  { "fieldName": "study_name", "displayName": "Study" },
                  { "fieldName": "model_name", "displayName": "Candidate Model" },
                  { "fieldName": "model_family", "displayName": "Family" },
                  { "fieldName": "mean_brier", "displayName": "Mean Brier" },
                  { "fieldName": "official_points", "displayName": "Official Points" },
                  { "fieldName": "log_loss", "displayName": "Log Loss" },
                  { "fieldName": "ece_calibration", "displayName": "ECE" },
                  { "fieldName": "wall_seconds", "displayName": "Wall Seconds" }
                ]
              },
              "frame": {
                "title": "Provenance-Partitioned Candidate Ranking Table"
              }
            },
            "datasetName": "ds_provenance_leaderboard"
          },
          "position": { "x": 0, "y": 4, "width": 12, "height": 6 }
        },
        {
          "widget": {
            "name": "chart_family_brier",
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": { "fieldName": "model_family", "displayName": "Model Family" },
                "y": { "fieldName": "mean_brier", "displayName": "Mean Brier", "aggregation": "MIN" },
