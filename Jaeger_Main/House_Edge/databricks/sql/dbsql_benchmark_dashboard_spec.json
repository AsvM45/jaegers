    {
      "name": "page_paired_ci95_gate",
      "displayName": "Paired CI95 & Ablation Gate",
      "layout": [
        {
          "widget": {
            "name": "title_paired_gate",
            "multilineTextboxSpec": {
              "lines": [
                "# Paired Bootstrap CI95 Hypothesis & Ablation Gate\n",
                "\n",
                "Evaluates candidate models against reference baselines using 2,000-sample episode-level paired bootstrap 95% confidence intervals. Only candidates whose 95% CI strictly clears zero (`ci95_high < 0` for Brier, `ci95_low > 0` for Points) pass promotion gating."
              ]
            }
          },
          "position": { "x": 0, "y": 0, "width": 12, "height": 2 }
        },
