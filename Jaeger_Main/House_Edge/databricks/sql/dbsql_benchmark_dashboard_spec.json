            "datasetName": "ds_provenance_leaderboard"
          },
          "position": { "x": 4, "y": 2, "width": 4, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_distinct_candidates",
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "model_name",
