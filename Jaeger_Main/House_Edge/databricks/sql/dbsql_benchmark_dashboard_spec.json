              },
              "frame": {
                "title": "Best Brier by Model Family and Provenance Tier"
              }
            },
            "datasetName": "ds_provenance_leaderboard"
          },
          "position": { "x": 0, "y": 10, "width": 12, "height": 5 }
        }
      ]
