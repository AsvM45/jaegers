            "multilineTextboxSpec": {
              "lines": [
                "# Governed Model Benchmark Leaderboard (Strict Provenance Isolation)\n",
                "\n",
                "Models are partitioned strictly by `evaluation_provenance` (`sampled_outcome_group_cv` vs `official_public_validation` vs `dev_exposed_public_validation_sampled_outcome`). Cross-provenance score comparisons are prohibited."
              ]
            }
          },
          "position": { "x": 0, "y": 0, "width": 12, "height": 2 }
        },
        {
          "widget": {
            "name": "kpi_best_cv_brier",
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "mean_brier",
                  "displayName": "Best Brier Score",
                  "aggregation": "MIN"
                }
              },
              "frame": {
                "title": "Lowest Observed Brier",
                "description": "Minimum Brier across governed clean trials"
              }
            },
            "datasetName": "ds_provenance_leaderboard"
          },
          "position": { "x": 0, "y": 2, "width": 4, "height": 2 }
        },
        {
